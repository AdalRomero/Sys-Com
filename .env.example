# ─── Supabase ────────────────────────────────────────────────────────────────
# Obtén estos valores en: https://app.supabase.com → Project Settings → API

VITE_SUPABASE_URL=https://<TU_PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<TU_ANON_KEY>

# ─── Desktop (Tauri) ─────────────────────────────────────────────────────────
# Deja en blanco para el build web. Pon "true" para el build de escritorio.
VITE_ES_DESKTOP=false

# ─── Modo Demo (Público) ───────────────────────────────────────────────────
# Pon "true" para que la web permita acceso público sin inicio de sesión
# a un entorno de visualización. En modo escritorio esto debería estar false.
VITE_MODO_DEMO=false
