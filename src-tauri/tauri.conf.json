{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "syscom",
  "version": "1.0.2",
  "identifier": "com.syscom.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "devtools": true,
        "title": "Syscom",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/syscom-ico.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/syscom-ico.ico"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}